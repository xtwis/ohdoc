{
  "name": "@xtwis/ohdoc",
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "description": "Scaffold a local VitePress dev environment for your repo with one CLI.",
  "author": "Twisuki",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "readme": "README.md",
  "homepage": "https://x.twis.uk/en/ohdoc/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtwis/ohdoc.git"
  },
  "bugs": "https://github.com/xtwis/ohdoc/issues",
  "keywords": [
    "cli",
    "documentation",
    "i18n",
    "mermaid",
    "scaffold",
    "sidebar",
    "typescript",
    "vitepress"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "ohdoc": "./dist/cli.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "pnpm lint && pnpm check && pnpm test:run && tsup",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit",
    "check:test": "tsc -p tsconfig.test.json",
    "fix": "eslint . --fix",
    "lint": "eslint",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "pnpm test run",
    "test:ui": "pnpm test --ui"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-mermaid-renderer": "^1.2.2",
    "vitepress-sidebar": "^1.40.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "@vitest/ui": "^4.1.9",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.21",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-mermaid-renderer": "^1.2.2",
    "vitepress-sidebar": "^1.40.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.43"
  }
}
